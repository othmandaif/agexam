# ─────────────────────────────────────────────────────────────
# AGExam — variables d'environnement
# Copier ce fichier en .env.local puis remplir les valeurs
# (Supabase > Project Settings > API / Database).
# ─────────────────────────────────────────────────────────────

# URL publique de l'application (liens dans les e-mails, redirections)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — utilisé UNIQUEMENT pour l'authentification
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé publishable (sb_publishable_...) ou ancienne clé "anon"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Clé SECRÈTE (sb_secret_... ou ancienne "service_role") — serveur uniquement, jamais NEXT_PUBLIC_
# Sert à créer les comptes, réinitialiser les mots de passe, bloquer un compte.
# Supabase > Project Settings > API Keys > Secret keys
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# Base de données — utilisée par Drizzle côté serveur uniquement
# Pooler en mode TRANSACTION (port 6543) pour l'application
DATABASE_URL=postgresql://postgres.xxxxxxxx:[MOT_DE_PASSE]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres
# Connexion directe (port 5432) pour les migrations drizzle-kit
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:[MOT_DE_PASSE]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Correction automatique des questions d'algorithme (relecture du code) — serveur uniquement,
# jamais NEXT_PUBLIC_. Sans clé, la note repose sur les seuls jeux d'essai.
DEEPSEEK_API_KEY=sk-xxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
